{
  "name": "heynabo-ics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Webcal/iCalendar feed for HeyNabo community events",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "token": "wrangler secret put HEYNABO_TOKEN",
    "feed-secret": "wrangler secret put FEED_SECRET",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.120.1"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heynabo-ics",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",

  // Non-secret configuration. Secrets (HEYNABO_TOKEN, FEED_SECRET) are set with
  // `npm run token` / `npm run feed-secret` and never live in this file.
  "vars": {
    "HEYNABO_BASE_URL": "https://staldhusene.spaces.heynabo.com",
    "CALENDAR_NAME": "Staldhusene",
    "PAST_EVENT_WINDOW_DAYS": "30",
  },

  // Explicit, because declaring "routes" makes Wrangler disable workers.dev by
  // default — which silently leaves the Worker with no reachable URL if the
  // route then fails to apply.
  "workers_dev": true,

  "observability": {
    "enabled": true,
  },
}

# Copy to .dev.vars (gitignored) for `npm run dev`.
# In production these are Worker secrets, set via `npm run token` and
# `npm run feed-secret` — never committed.

# PHPSESSID from a logged-in HeyNabo browser session.
HEYNABO_TOKEN="paste-phpsessid-here"

# Random path segment for the feed URL: openssl rand -hex 24
FEED_SECRET="local-dev-secret"

# Optional: id of the chore rota Google Sheet (the long segment after /d/ in
# its URL). Enables ?name=<your name> on the feed URL.
CHORE_SHEET_ID=""
